{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "title": { "label": "Video title", "type": "string" },
        "videoUrl": { "label": "Video URL", "type": "string" },
        "description": { "label": "Description", "type": "string" },
        "mp4Url": { "label": "MP4 URL", "type": "string" }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["title", "videoUrl", "description", "mp4Url"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "videoUrl": {
                        "label": "Video URL",
                        "format": "link"
                    },
                    "description": {
                        "label": "Description",
                        "format": "text"
                    },
                    "mp4Url": {
                        "label": "MP4 URL",
                        "format": "link"
                    }
                }
            }
        }
    }
}
